{
  "name": "material",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "projectType": "application",
  "prefix": "app",
  "sourceRoot": "apps/material/src",
  "tags": ["scope:material"],
  "targets": {
    "build": {
      "executor": "@angular/build:application",
      "outputs": ["{options.outputPath}"],
      "defaultConfiguration": "production",
      "options": {
        "outputPath": "dist/apps/material",
        "browser": "apps/material/src/main.ts",
        "tsConfig": "apps/material/tsconfig.app.json",
        "assets": [
          {
            "glob": "**/*",
            "input": "apps/material/public"
          },
          {
            "glob": "**/*.json",
            "input": "apps/libs/src/assets/i18n",
            "output": "assets/i18n"
          }
        ],
        "styles": ["apps/material/src/styles.scss"]
      },
      "configurations": {
        "production": {
          "budgets": [
            {
              "type": "initial",
              "maximumWarning": "1mb",
              "maximumError": "2mb"
            },
            {
              "type": "anyComponentStyle",
              "maximumWarning": "8kb",
              "maximumError": "12kb"
            }
          ],
          "outputHashing": "all"
        },
        "development": {
          "optimization": false,
          "extractLicenses": false,
          "sourceMap": true
        }
      }
    },
    "serve": {
      "continuous": true,
      "executor": "@angular/build:dev-server",
      "defaultConfiguration": "development",
      "options": {
        "proxyConfig": "apps/material/proxy.conf.js"
      },
      "configurations": {
        "production": {
          "buildTarget": "material:build:production"
        },
        "development": {
          "buildTarget": "material:build:development"
        }
      }
    },
    "lint": {
      "executor": "@nx/eslint:lint"
    },
    "test": {
      "executor": "@nx/vitest:test",
      "outputs": ["{options.reportsDirectory}"],
      "options": {
        "reportsDirectory": "coverage/apps/material"
      }
    },
    "serve-static": {
      "continuous": true,
      "executor": "@nx/web:file-server",
      "options": {
        "buildTarget": "material:build",
        "staticFilePath": "dist/apps/material/browser",
        "spa": true
      }
    }
  }
}
