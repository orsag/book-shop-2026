{
  "name": "book-store-2026",
  "version": "3.1.6",
  "license": "MIT",
  "workspaces": [
    "apps/*"
  ],
  "scripts": {
    "seed": "npx tsx prisma/seed.ts",
    "pipe": "clear && gitlab-ci-local",
    "kill": "clear && killall -9 node",
    "generate:client": "orval --config orval.config.ts",
    "install:browsers": "npx playwright install chromium",
    "lint": "npx nx run frontend:lint --skip-nx-cache 2>&1",
    "serve": "npx nx run-many -t serve --projects=frontend,backend --parallel=2 --output-style=stream",
    "build-fe": "npx nx build frontend --skip-nx-cache 2>&1 | tail -10",
    "build-be": "npx nx build backend --skip-nx-cache 2>&1 | tail -10",
    "build-libs": "npx nx build libs --skip-nx-cache 2>&1 | tail -5",
    "hono": "npx nx run hono-backend:serve",
    "playwright": "npx nx playwright frontend",
    "test": "npx nx test frontend",
    "clean": "rm -rf dist .angular/cache .nx/cache",
    "modules": "rm -rf node_modules package-lock.json",
    "e2e": "npx nx run frontend:e2e",
    "e2ebe": "npx nx run backend:e2e"
  },
  "private": true,
  "dependencies": {
